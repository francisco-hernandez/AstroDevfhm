---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { t, paths } from '../i18n';

const d = t('es').notFound;
const en = t('en').notFound;
---

<Layout lang="es" title={d.metaTitle} description={d.text} altHref={paths.en.home} noindex>
  <section class="wrap nf">
    <Scene id="perdido" size={260} />
    <p class="eyebrow"><b>404</b> {d.metaTitle.split('|')[0].trim()}</p>
    <h1 class="display h2">{d.title}{' '}<em>{d.em}</em></h1>
    <p class="text">{d.text}</p>
    <div class="ctas">
      <a href={paths.es.home} class="btn">{d.home}</a>
      <a href={paths.es.blog} class="btn btn-outline">{d.blog}</a>
    </div>
    <p class="en" lang="en">{en.title}{' '}<em>{en.em}</em> <a href={paths.en.home}>{en.home}</a></p>
  </section>
</Layout>

<style>
  .nf {
    padding-block: clamp(72px, 9vw, 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }
  .nf .eyebrow {
    margin: 12px 0 0;
  }
  .text {
    margin: 0;
    color: var(--muted);
    max-width: 520px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .en {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
</style>
