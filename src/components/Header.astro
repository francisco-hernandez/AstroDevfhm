---
import { t, paths, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'home' | 'blog' | 'other';
  altHref: string;
}

const { lang, page, altHref } = Astro.props;
const d = t(lang);
const p = paths[lang];
const tabs = d.nav.tabs.map((tab) => ({
  ...tab,
  href: page === 'home' ? (tab.id === 'top' ? '#top' : `#${tab.id}`) : `${p.home}${tab.id === 'top' ? '' : '#' + tab.id}`,
}));
const blogCurrent = page === 'blog';
const esHref = lang === 'es' ? Astro.url.pathname : altHref;
const enHref = lang === 'en' ? Astro.url.pathname : altHref;
---

<header class="site-header">
  <div class="wrap">
    <div class="capsule">
      <a href={p.home} class="logo display">devfhm<span>.</span></a>
      <nav class="tabs tabs-in" aria-label={d.nav.label}>
        <span class="pill" aria-hidden="true"></span>
        {tabs.map((tab) => (
          <a class="tab" href={tab.href} aria-label={`${tab.f} · ${tab.a}`} data-section={page === 'home' ? tab.id : undefined}>{tab.f}</a>
        ))}
        <a class="tab" href={p.blog} aria-label={`${d.nav.blogTab.f} · ${d.nav.blogTab.a}`} aria-current={blogCurrent ? 'page' : undefined}>{d.nav.blogTab.f}</a>
      </nav>
      <div class="controls">
        <div class="seg" role="group" aria-label={d.nav.lang}>
          <a href={esHref} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <button type="button" class="iconbtn theme-toggle" data-label-dark={d.nav.themeDark} data-label-light={d.nav.themeLight} aria-label={d.nav.themeDark}>
          <svg class="i-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg class="i-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </button>
        <a href={page === 'home' ? '#contacto' : `${p.home}#contacto`} class="btn btn-sm hdr-cta">{d.nav.cta}</a>
        <button type="button" class="iconbtn menu-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-movil" aria-label={d.nav.menu}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
        </button>
      </div>
    </div>
    <dialog id="menu-movil" class="mmenu" aria-label={d.nav.label}>
      <div class="mm-top">
        <a href={p.home} class="logo display">devfhm<span>.</span></a>
        <button type="button" class="iconbtn mm-close" autofocus aria-label={d.nav.close}>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <nav aria-label={d.nav.label}>
        <ol class="mm-list">
          {tabs.map((tab, i) => (
            <li style={`--i:${i}`}>
              <a class="mm-link" href={tab.href} data-section={page === 'home' ? tab.id : undefined}>
                <span class="mm-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="mm-a display">{tab.a}</span>
                <span class="mm-f">{tab.f}</span>
              </a>
            </li>
          ))}
          <li style={`--i:${tabs.length}`}>
            <a class="mm-link" href={p.blog} aria-current={blogCurrent ? 'page' : undefined}>
              <span class="mm-n">{String(tabs.length + 1).padStart(2, '0')}</span>
              <span class="mm-a display">{d.nav.blogTab.a}</span>
              <span class="mm-f">{d.nav.blogTab.f}</span>
            </a>
          </li>
        </ol>
      </nav>
      <a href={page === 'home' ? '#contacto' : `${p.home}#contacto`} class="btn mm-cta">{d.nav.cta}</a>
    </dialog>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-top: 12px;
  }
  .capsule {
    display: flex;
    align-items: center;
    gap: 12px;
    background: color-mix(in srgb, var(--surface) 95%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    box-shadow: 0 18px 40px -30px rgba(17, 25, 21, 0.5);
  }
  .logo {
    font-size: 22px;
    font-weight: 800;
    text-decoration: none;
    color: var(--ink);
  }
  .logo span {
    color: var(--ochre);
  }
  .tabs {
    position: relative;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px 0;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs-in {
    margin-left: 8px;
  }
  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    font: 500 13px 'JetBrains Mono Variable', monospace;
    color: var(--muted);
    text-decoration: none;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.3s ease;
  }
  .tabs .tab:hover {
    color: var(--ink);
    background: var(--ph);
  }
  .tabs .tab[aria-current] {
    color: var(--on-accent);
    background: var(--accent);
  }
  /* con JS, el fondo activo es una sola píldora que se desliza entre pestañas */
  .tabs.has-pill .tab[aria-current] {
    background: transparent;
  }
  .pill {
    position: absolute;
    top: 6px;
    left: 0;
    height: 40px;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  .pill-ready .pill {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), width 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .pill-ready .pill {
      transition: opacity 0.3s ease;
    }
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
  }
  .seg a {
    min-width: 44px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--muted);
    font: 500 13px 'JetBrains Mono Variable', monospace;
    text-decoration: none;
  }
  .seg a[aria-current] {
    background: var(--ink);
    color: var(--bg);
  }
  .iconbtn {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  :global([data-theme='dark']) .i-moon,
  :global([data-theme='light']) .i-sun {
    display: none;
  }
  /* menú móvil: panel a pantalla completa con <dialog> (foco atrapado, Esc y fondo inerte de serie) */
  .menu-btn {
    display: none;
  }
  @media (max-width: 1100px) {
    .tabs-in {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  :global(html:has(.mmenu[open])) {
    overflow: hidden;
  }
  .mmenu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 18px 20px calc(24px + env(safe-area-inset-bottom));
    border: 0;
    background: radial-gradient(ellipse at 85% 0%, var(--tint), transparent 60%), var(--bg);
    color: var(--ink);
    display: none;
    flex-direction: column;
    gap: 20px;
    overflow-y: auto;
  }
  .mmenu[open] {
    display: flex;
    animation: mm-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mmenu::backdrop {
    background: transparent;
  }
  @keyframes mm-in {
    from { opacity: 0; transform: translateY(-14px); }
  }
  .mm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 8px;
  }
  .mm-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mmenu[open] .mm-list li {
    animation: mm-item 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 45ms + 90ms);
  }
  @keyframes mm-item {
    from { opacity: 0; transform: translateY(12px); }
  }
  .mm-link {
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: baseline;
    padding: 14px;
    border-bottom: 1px solid var(--line);
    border-radius: 18px;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .mm-link:hover {
    background: var(--ph);
  }
  .mm-n {
    font: 500 12px 'JetBrains Mono Variable', monospace;
    color: var(--ochre);
  }
  .mm-a {
    font-size: clamp(26px, 7vw, 34px);
    font-weight: 700;
    line-height: 1.15;
  }
  .mm-f {
    grid-column: 2;
    font: 500 12px 'JetBrains Mono Variable', monospace;
    color: var(--muted);
  }
  .mm-link[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
    border-bottom-color: transparent;
  }
  .mm-link[aria-current] .mm-n,
  .mm-link[aria-current] .mm-f {
    color: var(--on-accent);
    opacity: 0.75;
  }
  .mm-cta {
    margin-top: auto;
    justify-content: center;
    min-height: 54px;
  }
  @media (max-width: 700px) {
    .hdr-cta {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const label = () => {
    if (!btn) return;
    btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? btn.dataset.labelLight! : btn.dataset.labelDark!);
  };
  label();
  btn?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    label();
  });

  // píldora deslizante bajo la pestaña activa
  const navs = [...document.querySelectorAll<HTMLElement>('.site-header .tabs')];
  const place = () =>
    navs.forEach((nav) => {
      const pill = nav.querySelector<HTMLElement>('.pill')!;
      const cur = nav.querySelector<HTMLElement>('.tab[aria-current]');
      const visible = !!cur && cur.offsetWidth > 0;
      pill.style.opacity = visible ? '1' : '0';
      if (!visible) return;
      pill.style.width = `${cur.offsetWidth}px`;
      pill.style.transform = `translateX(${cur.offsetLeft}px)`;
    });
  navs.forEach((n) => n.classList.add('has-pill'));

  // pestaña de la sección visible (solo en la home): la última cuya parte superior pasó bajo la cabecera
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
  if (links.length) {
    const sections = [...new Set(links.map((a) => a.dataset.section!))]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el && el.id !== 'top');
    let current = '';
    let locked = false;
    let ticking = false;
    const setCurrent = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a) => (a.dataset.section === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      place();
    };
    const update = () => {
      ticking = false;
      if (locked) return;
      let id = 'top';
      for (const el of sections) if (el.getBoundingClientRect().top < 160) id = el.id;
      setCurrent(id);
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    // al hacer clic, la píldora va directo al destino sin pasar por las secciones intermedias
    links.forEach((a) =>
      a.addEventListener('click', () => {
        setCurrent(a.dataset.section!);
        locked = true;
        const unlock = () => {
          locked = false;
          update();
        };
        addEventListener('scrollend', unlock, { once: true });
        setTimeout(unlock, 1200); // navegadores sin scrollend
      }),
    );
    update();
  }
  // menú móvil
  const menu = document.querySelector<HTMLDialogElement>('#menu-movil');
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  if (menu && menuBtn) {
    menuBtn.addEventListener('click', () => {
      menu.showModal();
      menuBtn.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', () => menuBtn.setAttribute('aria-expanded', 'false'));
    menu.querySelector('.mm-close')!.addEventListener('click', () => menu.close());
    // al elegir un destino se cierra y la página se desplaza hasta él
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    matchMedia('(min-width: 1101px)').addEventListener('change', (e) => e.matches && menu.close());
  }

  place();
  requestAnimationFrame(() => navs.forEach((n) => n.classList.add('pill-ready')));
  addEventListener('resize', place);
  document.fonts?.ready.then(place);
</script>
