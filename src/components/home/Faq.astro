---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).faq;
// Todas las respuestas están en el HTML (para Google y sin JS); el script solo muestra una cada vez.
---

<section id="faq" class="section" style="padding-top: 40px">
  <div class="wrap faq" data-faq>
    <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} center />
    <div role="tablist" aria-label={d.tabsLabel} class="tabs reveal" data-r="fade">
      {d.groups.map((g, gi) => (
        <button type="button" role="tab" id={`faq-tab-${gi}`} aria-controls={`faq-panel-${gi}`} aria-selected={gi === 0 ? 'true' : 'false'} tabindex={gi === 0 ? 0 : -1} class="ftab">
          {g.title}<span class="cnt">{g.items.length}</span>
        </button>
      ))}
    </div>
    <div class="stage reveal" data-r="scale">
      <div class="art">
        <Scene id="faq" size={340} alt={d.alt} />
        <span class="q q1 loop" aria-hidden="true">?</span>
        <span class="q q2 loop" aria-hidden="true">?</span>
        <span class="q q3 loop" aria-hidden="true">?</span>
      </div>
      <div>
        {d.groups.map((g, gi) => (
          <div role="tabpanel" id={`faq-panel-${gi}`} aria-labelledby={`faq-tab-${gi}`} hidden={gi !== 0} class="panel" aria-live="polite">
            <p class="mono pick">{d.pick}</p>
            <div class="qs">
              {g.items.map((it, i) => (
                <button type="button" class="fq" aria-pressed={gi === 0 && i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${gi}-${i}`} data-q={i}>{it.q}</button>
              ))}
            </div>
            {g.items.map((it, i) => (
              <div class="bubble" id={`faq-a-${gi}-${i}`} hidden={i !== 0}>
                <p class="eyebrow"><b>{String(i + 1).padStart(2, '0')}/{String(g.items.length).padStart(2, '0')}</b> {g.title}</p>
                <h3 class="display">{it.q}</h3>
                <p class="a">{it.a}</p>
              </div>
            ))}
          </div>
        ))}
        <div class="foot">
          <div class="navs">
            <button type="button" class="fnav" data-dir="-1" aria-label={d.prev}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg></button>
            <button type="button" class="fnav" data-dir="1" aria-label={d.next}><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
          </div>
          <p>{d.more} <a href="#contacto">{d.moreLink}</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* sin JavaScript se ven todas las preguntas y respuestas */
  :global(.no-js) .faq [hidden] {
    display: block !important;
  }
  :global(.no-js) .faq .tabs,
  :global(.no-js) .faq .foot,
  :global(.no-js) .faq .qs {
    display: none;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 36px;
  }
  @media (max-width: 700px) {
    .tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: none;
      padding-bottom: 4px;
    }
  }
  .ftab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 8px 0 20px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: 600 15px 'Inter Variable', sans-serif;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .ftab:hover {
    border-color: var(--accent);
  }
  .cnt {
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--ph);
    color: var(--muted);
    font: 500 12px 'JetBrains Mono Variable', monospace;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .ftab[aria-selected='true'] {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .ftab[aria-selected='true'] .cnt {
    background: var(--on-accent);
    color: var(--accent);
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: clamp(36px, 5vw, 64px);
    padding: clamp(24px, 4vw, 56px);
  }
  @media (max-width: 900px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .art {
    position: relative;
    justify-self: center;
    padding: 6%;
  }
  .q {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font: 400 34px/56px 'Instrument Serif', Georgia, serif;
    text-align: center;
    box-shadow: 0 14px 30px -16px rgba(0, 0, 0, 0.5);
    animation: bob 6s ease-in-out infinite;
    z-index: 2;
  }
  .q1 { top: 0; right: 4%; }
  .q2 { top: 42%; left: -2%; width: 42px; height: 42px; line-height: 42px; font-size: 26px; background: var(--ochre); color: var(--bg); animation-delay: 1.5s; }
  .q3 { bottom: 4%; right: 0; width: 46px; height: 46px; line-height: 46px; font-size: 28px; background: var(--bg); color: var(--accent); border: 1px solid var(--line); animation-delay: 3s; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .pick {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .qs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .fq {
    min-height: 44px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font: 500 14px/1.35 'Inter Variable', sans-serif;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .fq:hover {
    border-color: var(--accent);
  }
  .fq[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .bubble {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 40px 40px 0 0;
    border-bottom: 0;
    padding: clamp(22px, 3vw, 36px) clamp(22px, 3vw, 36px) 0;
    animation: appear 0.45s ease-out both;
  }
  .bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 48px;
    width: 26px;
    height: 26px;
    background: var(--bg);
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transform: rotate(45deg);
    border-radius: 0 0 0 8px;
  }
  @media (max-width: 900px) {
    .bubble::before {
      left: 50%;
      top: -14px;
      transform: translateX(-50%) rotate(135deg);
    }
  }
  .bubble .eyebrow {
    margin: 0 0 10px;
  }
  .bubble h3 {
    margin: 0 0 12px;
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 700;
  }
  .a {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 40px 40px;
    padding: 18px clamp(22px, 3vw, 36px) clamp(18px, 2.5vw, 28px);
  }
  .foot p {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .navs {
    display: flex;
    gap: 8px;
  }
  .fnav {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .fnav:hover {
    border-color: var(--accent);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    let g = 0;
    let q = 0;
    const show = (ng: number, nq: number, focusTab = false) => {
      g = ng;
      q = nq;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === g));
        tab.tabIndex = i === g ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== g;
        panel.querySelectorAll<HTMLButtonElement>('.fq').forEach((b, j) => b.setAttribute('aria-pressed', String(i === g && j === q)));
        panel.querySelectorAll<HTMLElement>('.bubble').forEach((b, j) => (b.hidden = !(i === g && j === q)));
      });
      if (focusTab) tabs[g].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i, 0));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          show((g + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, 0, true);
        }
      });
    });
    panels.forEach((panel, i) =>
      panel.querySelectorAll<HTMLButtonElement>('.fq').forEach((b, j) => b.addEventListener('click', () => show(i, j))),
    );
    const count = (i: number) => panels[i].querySelectorAll('.fq').length;
    root.querySelectorAll<HTMLButtonElement>('.fnav').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.dir === '1') {
          if (q < count(g) - 1) show(g, q + 1);
          else show((g + 1) % panels.length, 0);
        } else if (q > 0) show(g, q - 1);
        else {
          const pg = (g - 1 + panels.length) % panels.length;
          show(pg, count(pg) - 1);
        }
      }),
    );
  }
</script>
