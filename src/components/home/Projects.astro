---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).proj;
// shortcut: maquetas SVG en lugar de capturas; cambiar por capturas reales de cada proyecto (B-05)
---

<section id="proyectos" class="section band">
  <div class="wrap">
    <div class="top">
      <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} />
      <Scene id="proyectos" size={200} class="reveal" data-r="scale" />
    </div>
    <div class="grid">
      {d.items.map((p, i) => (
        <article class="reveal item" data-r="clip">
          <div class="browser">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="url">{p.url}</span></div>
            <div class="shot">
              {i === 0 && (
                <svg aria-hidden="true" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice"><rect width="400" height="250" fill="var(--bg)"></rect><rect x="20" y="18" width="56" height="9" rx="4.5" fill="var(--ink)"></rect><rect x="330" y="16" width="50" height="14" rx="7" fill="var(--accent)"></rect><rect x="20" y="62" width="196" height="16" rx="8" fill="var(--ink)"></rect><rect x="20" y="86" width="150" height="16" rx="8" fill="var(--ink)"></rect><rect x="20" y="114" width="180" height="7" rx="3.5" fill="var(--muted)" opacity=".5"></rect><rect x="20" y="150" width="84" height="22" rx="11" fill="var(--accent)"></rect><circle cx="308" cy="116" r="62" fill="var(--accent)" opacity=".16"></circle><circle cx="308" cy="116" r="34" fill="var(--ochre)" opacity=".55"></circle><rect x="20" y="196" width="112" height="38" rx="19" fill="var(--surface)" stroke="var(--line)"></rect><rect x="144" y="196" width="112" height="38" rx="19" fill="var(--surface)" stroke="var(--line)"></rect><rect x="268" y="196" width="112" height="38" rx="19" fill="var(--surface)" stroke="var(--line)"></rect></svg>
              )}
              {i === 1 && (
                <svg aria-hidden="true" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice"><rect width="400" height="250" fill="var(--bg)"></rect><rect x="20" y="18" width="70" height="9" rx="4.5" fill="var(--ink)"></rect><circle cx="372" cy="22" r="8" fill="var(--ochre)"></circle><rect x="20" y="46" width="360" height="54" rx="27" fill="var(--ochre)" opacity=".22"></rect><rect x="40" y="62" width="150" height="10" rx="5" fill="var(--ink)"></rect><rect x="20" y="114" width="110" height="74" rx="22" fill="var(--accent)" opacity=".2"></rect><rect x="145" y="114" width="110" height="74" rx="22" fill="var(--ochre)" opacity=".25"></rect><rect x="270" y="114" width="110" height="74" rx="22" fill="var(--accent)" opacity=".2"></rect><rect x="20" y="200" width="70" height="7" rx="3.5" fill="var(--ink)"></rect><rect x="145" y="200" width="70" height="7" rx="3.5" fill="var(--ink)"></rect><rect x="270" y="200" width="70" height="7" rx="3.5" fill="var(--ink)"></rect></svg>
              )}
              {i === 2 && (
                <svg aria-hidden="true" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice"><rect width="400" height="250" fill="var(--bg)"></rect><rect x="12" y="12" width="76" height="226" rx="22" fill="var(--ink)"></rect><rect x="28" y="34" width="40" height="8" rx="4" fill="var(--bg)" opacity=".9"></rect><rect x="28" y="62" width="44" height="6" rx="3" fill="var(--accent)"></rect><rect x="104" y="20" width="120" height="10" rx="5" fill="var(--ink)"></rect><rect x="104" y="46" width="84" height="56" rx="18" fill="var(--surface)" stroke="var(--line)"></rect><rect x="200" y="46" width="84" height="56" rx="18" fill="var(--surface)" stroke="var(--line)"></rect><rect x="296" y="46" width="84" height="56" rx="18" fill="var(--surface)" stroke="var(--line)"></rect><rect x="104" y="116" width="276" height="114" rx="22" fill="var(--surface)" stroke="var(--line)"></rect><path d="M120 206 C 150 180, 170 196, 196 186 S 236 146, 276 160 S 330 120, 364 136" stroke="var(--accent)" stroke-width="3" fill="none" stroke-linecap="round"></path></svg>
              )}
              <span class="caption mono">{p.img}</span>
            </div>
          </div>
          <p class="stats mono"><span class="add">+[M]</span><span class="del">−[N]</span><span>{p.tech}</span></p>
          <h3 class="display">{p.name}</h3>
          <p class="meta"><span class="k">{d.whyLabel}</span> {p.why}<br /><span class="k">{d.curLabel}</span> {p.cur}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--surface);
    border-radius: clamp(40px, 6vw, 80px);
    margin-inline: clamp(8px, 1.5vw, 24px);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .browser {
    border: 1px solid var(--line);
    border-radius: 28px;
    overflow: hidden;
    background: var(--surface);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .url {
    margin-left: 8px;
    flex: 1;
    font: 500 11px 'JetBrains Mono Variable', monospace;
    color: var(--muted);
    background: var(--bg);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .shot {
    aspect-ratio: 8 / 5;
    position: relative;
  }
  .shot svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .caption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    font-size: 12px;
    color: var(--muted);
    background: var(--surface);
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .stats {
    margin: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .stats span {
    border-radius: 999px;
    padding: 3px 12px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .stats .add {
    background: var(--add-bg);
    color: var(--add);
    border-color: transparent;
  }
  .stats .del {
    background: var(--del-bg);
    color: var(--del);
    border-color: transparent;
  }
  h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
  }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .k {
    font: 13px 'JetBrains Mono Variable', monospace;
    color: var(--ochre);
  }
</style>
