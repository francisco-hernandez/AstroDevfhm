---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).proj;
import { Image } from 'astro:assets';
import costarica from '../../assets/projects/costaricavidasilvestre.png';
import murcia from '../../assets/projects/media-maraton-murcia.png';
import pilates from '../../assets/projects/pilateslabv4.png';
import reiki from '../../assets/projects/svetlana-v3.png';
import slow from '../../assets/projects/slowcostarica.png';

// Capturas en el mismo orden que proj.items de src/i18n
import smdolor from '../../assets/projects/smdolor.png';
import orobann from '../../assets/projects/orobann.png';
import palacio from '../../assets/projects/palaciodeloro.png';
import ingepec from '../../assets/projects/ingepec.png';
import cei from '../../assets/projects/ceicrecemos.png';
const shots = [costarica, murcia, pilates, reiki, slow, smdolor, orobann, palacio, ingepec, cei];
---

<section id="proyectos" class="section band">
  <div class="wrap">
    <div class="top">
      <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} />
      <Scene id="proyectos" size={200} class="reveal" data-r="scale" />
    </div>
    <div class="grid">
      {d.items.map((p, i) => (
        <article class="reveal item" data-r="clip">
          <div class="browser">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="url">{p.url}</span></div>
            <div class="shot">
              <Image src={shots[i]} alt={`${d.shotAlt} ${p.name}`} widths={[400, 640, 960]} sizes="(min-width: 1100px) 400px, (min-width: 900px) 560px, 92vw" />
            </div>
          </div>
          <p class="stats mono"><span>{p.tech}</span>{p.agency && <span>{d.agency}</span>}</p>
          <h3 class="display"><a href={`https://${p.url}/`} target="_blank" rel="noopener">{p.name}<span class="sr-only"> {d.newTab}</span></a></h3>
          <p class="meta">{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--surface);
    border-radius: clamp(40px, 6vw, 80px);
    margin-inline: clamp(8px, 1.5vw, 24px);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px;
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .browser {
    border: 1px solid var(--line);
    border-radius: 28px;
    overflow: hidden;
    background: var(--surface);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .url {
    margin-left: 8px;
    flex: 1;
    font: 500 11px 'JetBrains Mono Variable', monospace;
    color: var(--muted);
    background: var(--bg);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .shot {
    aspect-ratio: 8 / 5;
    position: relative;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .stats {
    margin: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .stats span {
    border-radius: 999px;
    padding: 3px 12px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* toda la tarjeta es clicable; el enlace real es solo el título */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
  }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
</style>
