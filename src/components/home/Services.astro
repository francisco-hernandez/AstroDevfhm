---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).svc;
---

<section id="servicios" class="section">
  <div class="wrap">
    <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} center />
    <div class="grid">
      {d.main.map((s) => (
        <article class="card svc reveal">
          <Scene id={s.scene as any} size={170} class="pop" />
          <span class="fpill mono">{s.file}</span>
          <h3 class="display">{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
    <div class="extra reveal" data-r="fade">
      <span class="label">{d.extraLabel}</span>
      {d.extra.map((e) => (
        <p><span class="mono">{e.file}</span> <strong>{e.title}.</strong> <span class="muted">{e.text}</span></p>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }
  .svc {
    margin-top: 85px;
    padding-top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .svc :global(.pop) {
    margin-top: -85px;
  }
  .fpill {
    font-size: 12px;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
  }
  h3 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
  }
  .svc p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
  }
  .extra {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 36px;
  }
  .label {
    font: 600 12px 'Inter Variable', sans-serif;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    align-self: center;
  }
  .extra p {
    margin: 0;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 10px 20px;
  }
  .extra .mono {
    font-size: 13px;
    color: var(--ochre);
  }
  .muted {
    color: var(--muted);
  }
</style>
