---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).how;
---

<section id="como" class="section" style="padding-top: clamp(40px, 5vw, 72px)">
  <div class="wrap">
    <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} center />
    <div class="vine">
      <svg aria-hidden="true" viewBox="0 0 1200 180" preserveAspectRatio="none">
        <path d="M0 90 C 150 0, 300 180, 450 90 S 750 0, 900 90 S 1100 180, 1200 70" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity=".55"></path>
      </svg>
      <ol class="stations">
        {d.steps.map((s, i) => (
          <li class="reveal">
            <Scene id={s.scene as any} size={220} />
            <span class="badge" aria-hidden="true">0{i + 1}</span>
            <h3 class="display"><span class="sr-only">0{i + 1}. </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .vine {
    position: relative;
  }
  .vine > svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 60px;
    width: 100%;
    height: 180px;
  }
  @media (max-width: 900px) {
    .vine > svg {
      display: none;
    }
  }
  .stations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    position: relative;
  }
  .stations > li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .stations > li:nth-child(even) {
    margin-top: 72px;
  }
  @media (max-width: 900px) {
    .stations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stations > li:nth-child(even) {
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .stations {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .badge {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 500 15px 'JetBrains Mono Variable', monospace;
    margin-top: -38px;
    position: relative;
    z-index: 2;
    border: 5px solid var(--bg);
    box-sizing: content-box;
  }
  h3 {
    margin: 6px 0 0;
    font-size: 26px;
    font-weight: 700;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    max-width: 30ch;
  }
</style>
