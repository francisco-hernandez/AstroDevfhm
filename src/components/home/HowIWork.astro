---
import SectionHead from '../SectionHead.astro';
import Scene from '../Scene.astro';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const d = t(Astro.props.lang).how;
// El camino se dibuja de izquierda a derecha en DUR segundos (velocidad constante);
// cada parada aparece cuando el trazo llega a ella (12,5 %, 37,5 %, 62,5 % y 87,5 % del ancho).
const DUR = 4;
const PATH = 'M0 236 C 70 236, 90 213, 150 213 C 290 213, 330 285, 450 285 S 640 213, 750 213 S 940 285, 1050 285 S 1160 252, 1200 246';
---

<section id="como" class="section" style="padding-top: clamp(40px, 5vw, 72px)">
  <div class="wrap">
    <SectionHead n={d.n} eyebrow={d.eyebrow} title={d.title} em={d.em} intro={d.intro} center />
    <div class="vine" data-vine style={`--dur: ${DUR}s`}>
      <svg aria-hidden="true" viewBox="0 0 1200 360" preserveAspectRatio="none">
        <path class="track" d={PATH} pathLength="1"></path>
        <path class="trail" d={PATH} pathLength="1"></path>
        <circle class="walker" r="7">
          <animateMotion dur={`${DUR}s`} begin="indefinite" fill="freeze" path={PATH} calcMode="linear"></animateMotion>
        </circle>
      </svg>
      <ol class="stations">
        {d.steps.map((s, i) => (
          <li style={`--n: ${i}; --d: ${((i * 2 + 1) / 8) * DUR - 0.25}s`}>
            <div class="sc"><Scene id={s.scene as any} size={220} /></div>
            <span class="badge" aria-hidden="true">0{i + 1}</span>
            <h3 class="display"><span class="sr-only">0{i + 1}. </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .vine {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }
  svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 360px;
    overflow: visible;
  }
  .track {
    fill: none;
    stroke: var(--line);
    stroke-width: 2;
    stroke-dasharray: 0.004 0.012;
    stroke-linecap: round;
  }
  .trail {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .play .trail {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur) linear;
  }
  .walker {
    fill: var(--accent);
    opacity: 0;
    filter: drop-shadow(0 0 6px var(--glow));
    transition: opacity 0.4s ease;
  }
  .play .walker {
    opacity: 1;
  }
  @media (max-width: 900px) {
    svg {
      display: none;
    }
  }

  .stations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    position: relative;
  }
  .stations > li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .stations > li:nth-child(even) {
    margin-top: 72px;
  }
  @media (max-width: 900px) {
    .stations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stations > li:nth-child(even) {
      margin-top: 0;
    }
    .stations > li {
      --d: calc(var(--n) * 0.3s) !important;
    }
  }
  @media (max-width: 560px) {
    .stations {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* cada parada se enciende cuando llega el trazo: número → escena → título → texto */
  .sc,
  h3,
  p {
    opacity: 0;
    translate: 0 16px;
    transition: opacity 0.8s var(--ease), translate 0.9s var(--ease);
  }
  .sc {
    translate: none;
    scale: 0.9;
    transition: opacity 0.9s var(--ease), scale 1.1s var(--ease);
  }
  .badge {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    border: 5px solid var(--bg);
    box-shadow: 0 0 0 1px var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 500 15px 'JetBrains Mono Variable', monospace;
    margin-top: -38px;
    position: relative;
    z-index: 2;
    box-sizing: content-box;
    scale: 0.6;
    transition: scale 0.6s cubic-bezier(0.22, 1, 0.36, 1), background 0.4s ease, color 0.4s ease, box-shadow 0.6s ease;
  }
  .play .badge {
    scale: 1;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 0 0 1px var(--accent);
    transition-delay: var(--d);
  }
  .play .sc {
    opacity: 1;
    scale: none;
    transition-delay: calc(var(--d) + 0.1s);
  }
  .play h3 {
    opacity: 1;
    translate: none;
    transition-delay: calc(var(--d) + 0.3s);
  }
  .play p {
    opacity: 1;
    translate: none;
    transition-delay: calc(var(--d) + 0.45s);
  }
  :global(.no-js) .sc,
  :global(.no-js) h3,
  :global(.no-js) p {
    opacity: 1;
    translate: none;
    scale: none;
  }
  :global(.no-js) .badge {
    scale: 1;
  }
  h3 {
    margin: 6px 0 0;
    font-size: 26px;
    font-weight: 700;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    max-width: 30ch;
  }
  /* "reducir movimiento": el camino y las paradas aparecen con fundidos, sin desplazamientos */
  @media (prefers-reduced-motion: reduce) {
    .sc,
    h3,
    p {
      translate: none;
      scale: none;
    }
    .badge {
      scale: 1;
    }
    .walker {
      display: none;
    }
  }
</style>

<script>
  for (const vine of document.querySelectorAll<HTMLElement>('[data-vine]')) {
    const motion = vine.querySelector<SVGAnimationElement>('animateMotion');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const play = () => {
      vine.classList.add('play');
      if (!reduce) motion?.beginElement();
    };
    if (!('IntersectionObserver' in window)) play();
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting && e.intersectionRatio >= 0.3)) {
            play();
            io.disconnect();
          }
        },
        { threshold: [0, 0.3] },
      );
      io.observe(vine);
    }
  }
</script>
