---
import Scene from './Scene.astro';
import { t, paths, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  wave?: boolean;
}

const { lang, wave = true } = Astro.props;
const d = t(lang);
const p = paths[lang];
---

{wave && (
  <svg class="wave" aria-hidden="true" viewBox="0 0 1440 120" preserveAspectRatio="none" style="margin-bottom:-2px">
    <path d="M0 120H1440V64C1300 14 1160 86 1000 50C840 14 700 92 540 56C380 20 220 90 0 30Z" fill="var(--zone)"></path>
  </svg>
)}
<footer class="zone site-footer">
  <div class="wrap inner">
    <Scene id="pie" size={120} />
    <div class="statuscap">
      <span>⎇ main</span>
      <span>✓ {d.foot.reviewed}</span>
      <nav aria-label={d.foot.label}>
        <a href={p.privacy}>{d.foot.privacy}</a>
        <a href={p.terms}>{d.foot.terms}</a>
        <a href="https://github.com/francisco-hernandez" rel="me noopener">GitHub</a>
      </nav>
      <span>© {new Date().getFullYear()} Francisco Hernández</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 24px 0 32px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .statuscap {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    align-items: center;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    padding: 8px 26px;
    font: 500 13px 'JetBrains Mono Variable', monospace;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-left: auto;
  }
  a {
    color: var(--on-accent);
    text-decoration: none;
    padding: 10px 0;
    display: inline-block;
  }
  a:hover {
    color: var(--on-accent);
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .statuscap {
      border-radius: 28px;
      padding: 14px 22px;
    }
    nav {
      margin-left: 0;
    }
  }
</style>
