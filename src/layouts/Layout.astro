---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/commissioner';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/petrona';
import '@fontsource-variable/petrona/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { t, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string;
  page?: 'home' | 'blog' | 'other';
  jsonLd?: object;
  footerWave?: boolean;
  /** páginas que no deben indexarse ni tener URL canónica (404) */
  noindex?: boolean;
}

const { lang, title, description, altHref, page = 'other', jsonLd, footerWave = true, noindex = false } = Astro.props;
const d = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altHref, Astro.site);
// imagen para redes (1200×630) generada a partir del hero; una por idioma
const ogUrl = new URL(`/og-${lang}.jpg`, Astro.site);
const ogAlt = `${d.hero.lines.map((l) => [l.text, l.em].filter(Boolean).join(' ')).join(' ')} · Francisco Hernández, ${d.hero.sign}`;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={lang} href={canonical} />
        <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
        <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : alternate} />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DEVFHM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111915" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // tema antes de pintar: preferencia guardada o la del sistema
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        d.dataset.theme = dark ? 'dark' : 'light';
        if (saved) document.querySelector('meta[name="color-scheme"]').content = saved;
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{d.nav.skip}</a>
    <Header lang={lang} page={page} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} wave={footerWave} />
    <script>
      import '../scripts/reveal.ts';
      const ready = () => document.documentElement.classList.add('ready');
      const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(ready, { timeout: 1500 }) : setTimeout(ready, 300));
      if (document.readyState === 'complete') idle();
      else addEventListener('load', idle, { once: true });
    </script>
    <Analytics />
  </body>
</html>
