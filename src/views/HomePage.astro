---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import HowIWork from '../components/home/HowIWork.astro';
import AiAndMe from '../components/home/AiAndMe.astro';
import Services from '../components/home/Services.astro';
import Projects from '../components/home/Projects.astro';
import About from '../components/home/About.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import Contact from '../components/home/Contact.astro';
import { t, paths, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: 'DEVFHM',
      url: new URL(paths[lang].home, site).href,
      description: d.meta.description,
      areaServed: 'Costa Rica',
      founder: { '@type': 'Person', name: 'Francisco Hernández', jobTitle: lang === 'es' ? 'Diseñador y desarrollador web' : 'Web designer and developer' },
      email: 'contacto@devfhm.com',
      telephone: '+506 6308 9119',
    },
    {
      '@type': 'FAQPage',
      mainEntity: d.faq.groups.flatMap((g) =>
        g.items.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } })),
      ),
    },
  ],
};
---

<Layout lang={lang} title={d.meta.title} description={d.meta.description} altHref={paths[otherLang(lang)].home} page="home" jsonLd={jsonLd} footerWave={false}>
  <Hero lang={lang} />
  <HowIWork lang={lang} />
  <AiAndMe lang={lang} />
  <Services lang={lang} />
  <Projects lang={lang} />
  <About lang={lang} />
  <Testimonials lang={lang} />
  <Faq lang={lang} />
  <BlogPreview lang={lang} />
  <Contact lang={lang} />
</Layout>
