---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { t, paths, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'privacy' | 'terms';
}

const { lang, kind } = Astro.props;
const d = t(lang).legal;
const page = d[kind];
---

<Layout lang={lang} title={page.metaTitle} description={page.desc} altHref={paths[otherLang(lang)][kind]}>
  <article class="wrap legal">
    <Scene id="perdido" size={160} />
    <h1 class="display h2">{page.title}{' '}<em>{page.em}</em></h1>
    <p class="intro">{page.intro}</p>
    <p class="updated mono">{d.updated}</p>
    {page.sections.map((s) => (
      <section>
        <h2 class="display">{s.h}</h2>
        {s.p.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <a href={paths[lang].home} class="btn btn-outline">{d.back}</a>
  </article>
</Layout>

<style>
  .legal {
    padding-block: clamp(72px, 9vw, 120px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 820px;
  }
  .legal h1 {
    margin: 0;
  }
  .intro {
    margin: 0;
    font-size: 20px;
    color: var(--muted);
    max-width: 60ch;
  }
  .updated {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--ochre);
  }
  section {
    max-width: 68ch;
  }
  h2 {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    margin: 12px 0 10px;
  }
  section p {
    margin: 0 0 12px;
    text-wrap: pretty;
  }
  .btn {
    margin-top: 16px;
  }
</style>
